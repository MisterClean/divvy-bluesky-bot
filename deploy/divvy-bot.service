[Unit]
Description=Divvy Station Bluesky Bot
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment="DIVVY_BOT_IMAGE=divvy-bluesky-bot:2.0.0"
EnvironmentFile=-/etc/divvy-bot-image.env
ExecStartPre=-/usr/bin/docker rm -f divvy-station-bot
ExecStart=/usr/bin/docker run --rm --name divvy-station-bot --init --pids-limit 256 --cap-drop ALL --security-opt no-new-privileges --tmpfs /tmp:rw,nosuid,nodev,size=256m --env-file /etc/divvy-bot.env --volume /var/lib/divvy-bot:/var/lib/divvy-bot ${DIVVY_BOT_IMAGE}
TimeoutStartSec=20min

[Install]
WantedBy=multi-user.target
