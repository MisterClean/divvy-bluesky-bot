#!/usr/bin/env bash
set -Eeuo pipefail

readonly ENV_FILE="/etc/divvy-bot.env"
readonly BOT_TIMER="divvy-bot.timer"
readonly MAX_SUCCESS_AGE_SECONDS=$((8 * 60 * 60))
readonly MINIMUM_FREE_BYTES=$((3 * 1024 * 1024 * 1024))

log() {
  printf '%s %s\n' "$(date --utc +'%Y-%m-%dT%H:%M:%SZ')" "$*"
}

fail() {
  log "ERROR: $*" >&2
  exit 1
}

for required_command in date df sqlite3 systemctl; do
  command -v "$required_command" >/dev/null ||
    fail "Required command is unavailable: ${required_command}"
done

[[ -r "$ENV_FILE" ]] || fail "Missing production environment file: ${ENV_FILE}"

database_path="$({
  awk -F= '$1 == "DB_PATH" {
    sub(/^DB_PATH=/, "")
    print
    exit
  }' "$ENV_FILE"
})"
[[ "$database_path" == /* ]] || fail "DB_PATH must be absolute"
[[ -f "$database_path" ]] || fail "Database does not exist: ${database_path}"

integrity="$(sqlite3 -readonly "$database_path" 'PRAGMA integrity_check;')"
[[ "$integrity" == "ok" ]] || fail "SQLite integrity check failed: ${integrity}"

ready_deliveries="$({
  sqlite3 -readonly "$database_path" \
    "SELECT count(*) FROM deliveries WHERE status != 'delivered';"
})"
[[ "$ready_deliveries" == "0" ]] ||
  fail "${ready_deliveries} deliveries are not delivered"

latest_success="$({
  sqlite3 -readonly "$database_path" \
    "SELECT coalesce(max(finished_at), '') FROM runs WHERE status = 'succeeded';"
})"
[[ -n "$latest_success" ]] || fail "No successful bot run is recorded"

latest_success_epoch="$(date --date="$latest_success" +%s)"
now_epoch="$(date +%s)"
success_age_seconds=$((now_epoch - latest_success_epoch))
((success_age_seconds <= MAX_SUCCESS_AGE_SECONDS)) ||
  fail "Last successful run is ${success_age_seconds} seconds old"

systemctl is-active --quiet "$BOT_TIMER" || fail "${BOT_TIMER} is not active"

free_bytes="$({
  df --output=avail --block-size=1 "$database_path" | awk 'NR == 2 { print $1 }'
})"
[[ "$free_bytes" =~ ^[0-9]+$ ]] || fail "Could not determine free disk space"
((free_bytes >= MINIMUM_FREE_BYTES)) ||
  fail "Less than 3 GiB is free beneath the bot database"

log "Healthy: integrity=ok pending=0 success_age_seconds=${success_age_seconds} free_bytes=${free_bytes}"
