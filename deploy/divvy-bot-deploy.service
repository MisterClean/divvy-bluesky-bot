[Unit]
Description=Deploy the promoted Divvy bot image
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/etc/divvy-bot.env

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/deploy-divvy-bot
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=idle
